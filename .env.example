# Enter the key only in .env, never frontend code or chat.
GNANI_API_KEY=
# Run python setup_owner.py to set this hash without displaying a password.
OWNER_PASSWORD_HASH=
APP_ENV=development
# Required HTTPS origin when APP_ENV=production (no trailing path).
PUBLIC_ORIGIN=
# Optional absolute path; leave blank if ffprobe is on PATH.
FFPROBE_PATH=

# Enable only after Batch pricing/access and a consented live test are approved.
GNANI_BATCH_ENABLED=false
